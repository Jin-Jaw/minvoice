// Jin&Jaw production invoice service. The database id is filled after
// `npx wrangler d1 create jinjaw-invoices` and must remain stable: it identifies
// the production books.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jinjaw-invoices",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinjaw-invoices",
      // npx wrangler d1 create jinjaw-invoices → paste the id it prints
      "database_id": "89506611-6707-4664-8c32-73d560c99fec"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://invoices.jin-jaw.co.uk",
    "ACCESS_TEAM_DOMAIN": "jad-7b5.cloudflareaccess.com",
    "ACCESS_AUD": "3acc90a49b373a3b27f762486357338be8d5ec7f5b1e1e4c713219c76d8b287f"
  },
  "routes": [
    {
      "pattern": "invoices.jin-jaw.co.uk",
      "custom_domain": true
    }
  ],
  // Keep the unauthenticated workers.dev hostname off. The custom domain is
  // the only production entry point.
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // Daily overdue-reminder check (15:00 UTC). Does nothing unless payment
  // reminders are switched on in Settings → Email.
  "triggers": { "crons": ["0 15 * * *"] }
}
