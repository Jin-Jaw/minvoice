// Jin&Jaw production invoice service. This database was created with the
// explicit `eu` jurisdiction before any invoice data was entered.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jinjaw-invoices",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["contract@jin-jaw.co.uk"]
    }
  ],
  "ratelimits": [
    {
      "name": "PDF_RATE_LIMITER",
      "namespace_id": "73117",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "WEBHOOK_RATE_LIMITER",
      "namespace_id": "73118",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinjaw-invoices-eu",
      "database_id": "59c4bd62-7519-4feb-8c85-d84f31b2d572"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://invoices.jin-jaw.co.uk",
    "ACCESS_TEAM_DOMAIN": "jad-7b5.cloudflareaccess.com",
    "ACCESS_AUD": "3acc90a49b373a3b27f762486357338be8d5ec7f5b1e1e4c713219c76d8b287f"
  },
  "routes": [
    {
      "pattern": "invoices.jin-jaw.co.uk",
      "custom_domain": true
    }
  ],
  // Keep the unauthenticated workers.dev hostname off. The custom domain is
  // the only production entry point.
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // Daily overdue-reminder check (15:00 UTC). Does nothing unless payment
  // reminders are switched on in Settings → Email.
  "triggers": { "crons": ["0 15 * * *"] }
}
