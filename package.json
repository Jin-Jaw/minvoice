{
  "name": "@jin-jaw/invoices",
  "version": "0.1.0",
  "private": true,
  "description": "Jin&Jaw's private invoice archive and invoice generator on Cloudflare Workers and D1.",
  "license": "MIT",
  "homepage": "https://invoices.jin-jaw.co.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jin-Jaw/minvoice.git"
  },
  "keywords": [
    "invoicing",
    "invoice-generator",
    "cloudflare-workers",
    "cloudflare-d1",
    "hono",
    "stripe",
    "paypal",
    "self-hosted",
    "serverless"
  ],
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy && node scripts/ensure-master-key.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:backup:prod": "node scripts/backup.mjs"
  },
  "dependencies": {
    "hono": "4.13.5",
    "jose": "^5.9.0",
    "pdf-lib": "^1.17.1",
    "stripe": "^17.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "typescript": "^5.6.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "Password for /admin until you configure Cloudflare Access (which disables it automatically). Pick something long."
      }
    }
  }
}
